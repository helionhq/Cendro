# Copy to .env on the VPS and chmod 600.
# WEB_IMAGE is pulled by deploy/update.sh; pin a sha-* tag to roll back.
WEB_IMAGE=ghcr.io/helionhq/cendro-web:latest

# Baked into the browser bundle at build time. Keep these identical to the
# values in the GitHub Actions repository variables.
NEXT_PUBLIC_CONVEX_URL=https://animated-opossum-192.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me

# Runtime secrets. PLATFORM_ADMIN_CLERK_USER_IDS and AI_CHAT_PERSISTENCE_SECRET
# must match the values in the Convex production deployment.
CLERK_SECRET_KEY=sk_live_replace_me
PLATFORM_ADMIN_CLERK_USER_IDS=user_replace_me
AI_CHAT_PERSISTENCE_SECRET=replace_me
FIREWORKS_API_KEY=replace_me
AI_GATEWAY_API_KEY=replace_me
FIRECRAWL_API_KEY=replace_me
